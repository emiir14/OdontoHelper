# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# VITE_GITHUB_REPO: Repository "owner/repo" for resolving desktop/mobile GitHub Releases
VITE_GITHUB_REPO="emiir14/LocalTrans"

# ==============================================================================
# VERCEL + SUPABASE (AUTH, CLOUD DB & STORAGE)
# (Audio PCM crudo y transcripción Whisper corren 100% locales en el navegador)
# ==============================================================================

# Supabase PostgreSQL + Auth + Storage (ejecutá supabase/schema.sql en Supabase)
VITE_SUPABASE_URL="https://tu-proyecto.supabase.co"
VITE_SUPABASE_ANON_KEY="tu_supabase_anon_key"
