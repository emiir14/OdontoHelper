# ==============================================================================
# ODONTOHELPER · VARIABLES DE ENTORNO (PLANTILLA SIN SECRETOS)
# ==============================================================================
# Copiá estas variables en Vercel -> Project Settings -> Environment Variables
# (o en tu archivo local `.env.local` para desarrollo; nunca subas `.env.local` a Git).

# --- 1. Frontend Web + Apps Nativas (Vite: requieren prefijo VITE_) ---
# Supabase PostgreSQL + Auth + Storage (ejecutá setup/supabase-schema.sql primero)
VITE_SUPABASE_URL="https://tu-proyecto.supabase.co"
VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.ejemplo_anon_public_key"

# Repositorio GitHub para enlaces de instaladores desktop/móvil (owner/repo)
VITE_GITHUB_REPO="emiir14/LocalTrans"

# --- 2. Google Calendar OAuth vía Firebase Auth (Opcional; nunca subir claves reales a Git) ---
VITE_FIREBASE_API_KEY="AIzaSyEjemploClaveWebRestringidaPorDominio"
VITE_FIREBASE_AUTH_DOMAIN="tu-proyecto-id.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="tu-proyecto-id"
VITE_FIREBASE_STORAGE_BUCKET="tu-proyecto-id.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="123456789012"
VITE_FIREBASE_APP_ID="1:123456789012:web:abcdef1234567890"

# ==============================================================================
# 3. SOLO GITHUB ACTIONS · FIRMA DE INSTALADORES (.apk / .exe) - OPCIONALES
# ==============================================================================
# NO van en Vercel ni en `.env.local`. Se cargan únicamente en GitHub ->
# Settings -> Secrets and variables -> Actions cuando firmes releases:
#
# # Secrets (Android APK keystore permanente en base64):
# ANDROID_KEYSTORE_BASE64="MIIJ...base64_del_archivo_jks..."
# ANDROID_KEYSTORE_PASSWORD="tu_password_keystore"
# ANDROID_KEY_ALIAS="odontohelper"
# ANDROID_KEY_PASSWORD="tu_password_alias"
#
# # Secret + Variables (Windows EXE con SignPath Foundation):
# SIGNPATH_API_TOKEN="sp_ejemplo_token_signpath"
# SIGNPATH_ORGANIZATION_ID="00000000-0000-0000-0000-000000000000"
# SIGNPATH_PROJECT_SLUG="odontohelper"
# SIGNPATH_SIGNING_POLICY_SLUG="release-signing"

# ==============================================================================
# 4. FUTURO PLAN EXTRA · CLOUDFLARE R2 (SOLO SERVIDOR / VERCEL FUNCTIONS)
# ==============================================================================
# NO configurar en el MVP actual. NO agregar prefijo VITE_ a estas variables.
# Nota: /api/health y /api/agenda-feed.ics en Vercel ya leen automáticamente
# VITE_SUPABASE_URL y VITE_SUPABASE_ANON_KEY si no definís SUPABASE_URL/SUPABASE_ANON_KEY.
# Cuando se active Plan Extra en Cloudflare R2 (/api/audio-presign.ts):
#
# R2_ACCOUNT_ID="tu_cloudflare_account_id_32_hex"
# R2_ACCESS_KEY_ID="tu_r2_access_key_id"
# R2_SECRET_ACCESS_KEY="tu_r2_secret_access_key"
# R2_BUCKET_NAME="odontohelper-audios"
# SUPABASE_URL="https://tu-proyecto.supabase.co"
# SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.ejemplo_anon_public_key"
