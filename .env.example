# ==============================================================================
# ODONTOHELPER · VARIABLES DE ENTORNO (PLANTILLA SIN SECRETOS)
# ==============================================================================
# Copiá estas variables en Vercel -> Project Settings -> Environment Variables
# (o en tu archivo local `.env.local` para desarrollo).

# --- Frontend Web (Vite: requieren prefijo VITE_) ---
# Supabase PostgreSQL + Auth + Storage (ejecutá setup/supabase-schema.sql primero)
VITE_SUPABASE_URL="https://tu-proyecto.supabase.co"
VITE_SUPABASE_ANON_KEY="tu_supabase_anon_public_key"

# Repositorio GitHub para enlaces de instaladores desktop/móvil (owner/repo)
VITE_GITHUB_REPO="emiir14/OdontoHelper"

# --- Google Calendar / Firebase Auth (Opcional: configurar en Vercel y .env.local; nunca subir claves reales a Git) ---
# IMPORTANTE: VITE_FIREBASE_API_KEY debe ser una clave web NUEVA y válida creada en
# Google Cloud Console (APIs y servicios -> Credenciales) y restringida por dominio
# (odontohelper.vercel.app, localhost, tauri.localhost) + API Identity Toolkit.
# La clave que circuló en commits anteriores está revocada/vencida.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ==============================================================================
# FUTURO PLAN EXTRA · CLOUDFLARE R2 (SOLO SERVIDOR / VERCEL FUNCTIONS)
# ==============================================================================
# NO configurar en el MVP actual. NO agregar prefijo VITE_ a estas variables.
# Solo se usarán en /api/audio-presign.ts cuando se active Plan Extra en R2:
#
# R2_ACCOUNT_ID="tu_cloudflare_account_id"
# R2_ACCESS_KEY_ID="tu_r2_access_key_id"
# R2_SECRET_ACCESS_KEY="tu_r2_secret_access_key"
# R2_BUCKET_NAME="odontohelper-audios"
# SUPABASE_URL="https://tu-proyecto.supabase.co"
# SUPABASE_ANON_KEY="tu_supabase_anon_public_key"
